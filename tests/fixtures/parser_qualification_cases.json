{
  "cases": [
    {
      "command": "printf qualification",
      "expected": {"dynamic": false, "valid": true},
      "id": "benchmark_static"
    },
    {
      "command": "printf '%s' 'left && right | tail'",
      "expected": {"dynamic": false, "valid": true},
      "id": "quoted_controls"
    },
    {
      "command": "printf foo\\;bar",
      "expected": {"dynamic": false, "valid": true},
      "id": "escaped_control"
    },
    {
      "command": "printf '%s' 'single quoted'",
      "expected": {"dynamic": false, "valid": true},
      "id": "single_quote"
    },
    {
      "command": "printf \"%s\" \"$HOME\"",
      "expected": {"dynamic": true, "valid": true},
      "id": "double_quote_expansion"
    },
    {
      "command": "printf '%s' \"$(printf '%s' \"$(date)\")\"",
      "expected": {"dynamic": true, "valid": true},
      "id": "nested_command_substitution"
    },
    {
      "command": "printf '%s' `date`",
      "expected": {"dynamic": true, "valid": true},
      "id": "legacy_backticks"
    },
    {
      "command": "printf '%s' \"${VALUE:-fallback}\"",
      "expected": {"dynamic": true, "valid": true},
      "id": "parameter_expansion"
    },
    {
      "command": "printf '%s' \"$((1 + VALUE))\"",
      "expected": {"dynamic": true, "valid": true},
      "id": "arithmetic_expansion"
    },
    {
      "command": "diff <(printf a) <(printf b)",
      "expected": {"dynamic": true, "valid": true},
      "id": "process_substitution"
    },
    {
      "command": "cat <<EOF\n$VALUE\nEOF\n",
      "expected": {"dynamic": true, "valid": true},
      "id": "heredoc_expandable"
    },
    {
      "command": "cat <<'EOF'\n$VALUE\nEOF\n",
      "expected": {"dynamic": false, "valid": true},
      "id": "heredoc_quoted"
    },
    {
      "command": "cat <<-EOF\n\ttabbed\n\tEOF\n",
      "expected": {"dynamic": false, "valid": true},
      "id": "heredoc_tab_stripping"
    },
    {
      "command": "cat <<< \"value\"",
      "expected": {"dynamic": false, "valid": true},
      "id": "here_string"
    },
    {
      "command": "printf x 2>&1 >out",
      "expected": {"dynamic": false, "valid": true},
      "id": "redirection_order"
    },
    {
      "command": "rev >output <<< hello",
      "expected": {"dynamic": false, "valid": true},
      "id": "redirect_then_here_string"
    },
    {
      "command": "true && printf x",
      "expected": {"dynamic": false, "valid": true},
      "id": "and_chain"
    },
    {
      "command": "false || printf x",
      "expected": {"dynamic": false, "valid": true},
      "id": "or_chain"
    },
    {
      "command": "printf a; printf b",
      "expected": {"dynamic": false, "valid": true},
      "id": "sequence_chain"
    },
    {
      "command": "printf a | cat",
      "expected": {"dynamic": false, "valid": true},
      "id": "pipeline"
    },
    {
      "command": "printf a & wait",
      "expected": {"dynamic": false, "valid": true},
      "id": "background_chain"
    },
    {
      "command": "bash -c 'printf x && printf y'",
      "expected": {"dynamic": false, "valid": true, "wrapper_payload_opaque": true},
      "id": "bash_c_wrapper"
    },
    {
      "command": "printf 'unterminated",
      "expected": {"dynamic": false, "valid": false},
      "id": "malformed_quote"
    },
    {
      "command": "printf $(date",
