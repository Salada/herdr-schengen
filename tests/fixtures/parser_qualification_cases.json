    },
    {
      "command": "cat <<EOF\nunterminated\n",
      "expected": {"dynamic": false, "valid": false},
      "id": "malformed_heredoc"
    },
    {
      "command": "if true; then printf x",
      "expected": {"dynamic": false, "valid": false},
      "id": "malformed_conditional"
    },
    {
      "command": "for item in a b; do printf x",
      "expected": {"dynamic": false, "valid": false},
      "id": "malformed_loop"
    },
    {
      "command": "printf valid; 'unterminated",
